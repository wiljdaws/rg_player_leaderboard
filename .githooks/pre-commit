#!/usr/bin/env bash
# Content-hash the asset version so it moves only when JS/CSS actually
# changes. On 2026-08-06 we bumped ?v=b1 → b25 in one afternoon; every
# bump forced every open browser and Playwright worker to hard-reload
# and re-attach a fresh onSnapshot on the leaderboard collection. Result:
# ~50-60K Firestore reads charged to us. This hook makes that impossible
# to repeat by hand.
#
# Also regenerates the <script type="importmap"> block so every js/*.js
# file gets its version query. New files show up in the map automatically
# instead of quietly missing out on cache-busting.
#
# Enable: git config core.hooksPath .githooks
# (or run `bash .githooks/install.sh` to do it for you)

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

index_file="index.html"
[[ -f "$index_file" ]] || exit 0  # nothing to gate

# Compute a stable 8-char hash across all JS/CSS the site loads. Any
# content change moves the hash; unrelated commits (docs, tests, mockups)
# leave it alone.
hash=$(cat js/*.js css/*.css 2>/dev/null | shasum -a 1 | cut -c1-8)
[[ -n "$hash" ]] || exit 0  # no assets tracked, nothing to do

# Build the importmap block from the actual filesystem so nothing is
# forgotten. Written to a temp file; we splice it into index.html below.
build_importmap() {
  local h="$1"
  local out="$2"
  local files=()
  for f in js/*.js; do
    [[ -f "$f" ]] || continue
    # Classic <script src> tags already carry ?v= and are not imported.
    case "$(basename "$f")" in
      app.js|register-sw.js) continue ;;
    esac
    files+=("$f")
  done
  # Longest filename decides the column width so the JSON stays aligned.
  local maxlen=0
  for f in "${files[@]}"; do
    local key="./$f"
    (( ${#key} > maxlen )) && maxlen=${#key}
  done
  {
    echo '<script type="importmap">'
    echo '{'
    echo '  "imports": {'
    local n=${#files[@]}
    local i=0
    for f in "${files[@]}"; do
      i=$((i + 1))
      local key="./$f"
      local pad=$((maxlen - ${#key}))
      local spaces
      spaces=$(printf '%*s' "$pad" '')
      if (( i < n )); then
        printf '    "%s":%s "%s?v=%s",\n' "$key" "$spaces" "$key" "$h"
      else
        printf '    "%s":%s "%s?v=%s"\n' "$key" "$spaces" "$key" "$h"
      fi
    done
    echo '  }'
    echo '}'
    echo '</script>'
  } > "$out"
}

# Splice a freshly-built importmap into index.html between the existing
# <script type="importmap"> ... </script> tags. Requires that the tags
# already exist — a one-time seed is fine since they're checked in.
rewrite_importmap_in_file() {
  local target="$1"
  local h="$2"
  local mapfile
  mapfile=$(mktemp)
  build_importmap "$h" "$mapfile"
  local out
  out=$(mktemp)
  awk -v mapfile="$mapfile" '
    BEGIN { skipping = 0 }
    /<script type="importmap">/ {
      while ((getline line < mapfile) > 0) print line
      close(mapfile)
      skipping = 1
      next
    }
    skipping && /<\/script>/ { skipping = 0; next }
    skipping { next }
    { print }
  ' "$target" > "$out"
  mv "$out" "$target"
  rm -f "$mapfile"
}

current=$(grep -oE '\?v=[a-z0-9]+' "$index_file" | head -1 | sed 's/^?v=//')

# Always regenerate the importmap so a newly-added js/foo.js can't slip
# through without cache-busting even when the top-level hash hasn't moved
# (the hash is stable across renames, and file-set drift matters here).
sed -i.bak -E "s/\\?v=[a-z0-9]+/?v=${hash}/g" "$index_file"
sed -i.bak -E "s/data-asset-version=\"[a-z0-9]+\"/data-asset-version=\"${hash}\"/g" "$index_file"
rm -f "${index_file}.bak"
rewrite_importmap_in_file "$index_file" "$hash"

# CSP hashes the exact importmap body. Refresh it so a version bump
# cannot leave a stale sha256 that blocks every module load.
python3 - "$index_file" <<'PY'
import base64, hashlib, pathlib, re, sys
path = pathlib.Path(sys.argv[1])
html = path.read_text()
match = re.search(r'<script type="importmap">(.*?)</script>', html, re.S)
if not match:
    raise SystemExit("pre-commit: importmap script not found")
digest = base64.b64encode(hashlib.sha256(match.group(1).encode()).digest()).decode()
updated, n = re.subn(
    r"(script-src 'self' https://www.gstatic.com https://apis.google.com )'sha256-[^']+'",
    rf"\1'sha256-{digest}'",
    html,
    count=1,
)
if n != 1:
    raise SystemExit("pre-commit: could not refresh importmap CSP hash")
if updated != html:
    path.write_text(updated)
PY

if [[ "$current" != "$hash" ]]; then
  echo "pre-commit: assets changed — bumping ?v= from '${current}' to '${hash}'"
fi

# Only stage index.html if it actually differs from what's committed.
if ! git diff --quiet -- "$index_file"; then
  git add "$index_file"
fi

