#!/usr/bin/env bash
# Content-hash the asset version so it moves only when JS/CSS actually
# changes. On 2026-08-06 we bumped ?v=b1 → b25 in one afternoon; every
# bump forced every open browser and Playwright worker to hard-reload
# and re-attach a fresh onSnapshot on the leaderboard collection. Result:
# ~50-60K Firestore reads charged to us. This hook makes that impossible
# to repeat by hand.
#
# Enable: git config core.hooksPath .githooks
# (or run `bash .githooks/install.sh` to do it for you)

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

index_file="index.html"
[[ -f "$index_file" ]] || exit 0  # nothing to gate

# Compute a stable 8-char hash across all JS/CSS the site loads. Any
# content change moves the hash; unrelated commits (docs, tests, mockups)
# leave it alone.
hash=$(cat js/*.js css/*.css 2>/dev/null | shasum -a 1 | cut -c1-8)
[[ -n "$hash" ]] || exit 0  # no assets tracked, nothing to do

current=$(grep -oE '\?v=[a-z0-9]+' "$index_file" | head -1 | sed 's/^?v=//')

if [[ "$current" == "$hash" ]]; then
  # Assets haven't changed. If someone hand-edited a ?v= line anyway,
  # revert index.html to keep the hash consistent with the tree.
  if git diff --cached --name-only | grep -qx "$index_file"; then
    staged_current=$(git show ":${index_file}" | grep -oE '\?v=[a-z0-9]+' | head -1 | sed 's/^?v=//')
    if [[ "$staged_current" != "$hash" ]]; then
      echo "pre-commit: assets unchanged (hash=$hash) — undoing ?v= bump in $index_file"
      # Rewrite the staged copy to keep the hash pinned.
      tmp=$(mktemp)
      git show ":${index_file}" | sed -E "s/\\?v=[a-z0-9]+/?v=${hash}/g" > "$tmp"
      # Also rewrite data-asset-version="X" strings.
      sed -i.bak -E "s/data-asset-version=\"[a-z0-9]+\"/data-asset-version=\"${hash}\"/g" "$tmp" && rm -f "${tmp}.bak"
      git update-index --cacheinfo 100644 "$(git hash-object -w "$tmp")" "$index_file"
      rm -f "$tmp"
    fi
  fi
  exit 0
fi

echo "pre-commit: assets changed — bumping ?v= from '${current}' to '${hash}'"

# Rewrite index.html in-place so the working tree matches what gets committed.
sed -i.bak -E "s/\\?v=[a-z0-9]+/?v=${hash}/g" "$index_file"
sed -i.bak -E "s/data-asset-version=\"[a-z0-9]+\"/data-asset-version=\"${hash}\"/g" "$index_file"
rm -f "${index_file}.bak"

git add "$index_file"

# Belt & suspenders: reject commits whose only diff is the ?v= line —
# usually means someone tried to hand-bump for a redeploy nudge, which
# is the anti-pattern this hook exists to prevent.
staged_files=$(git diff --cached --name-only)
if [[ "$staged_files" == "$index_file" ]]; then
  # Only index.html is staged. Check whether the only real change is the version.
  # A `?v=` bump touches ~15 lines matching that pattern plus the data-asset-version.
  non_version_diff=$(git diff --cached "$index_file" | \
    grep -E '^[+-]' | \
    grep -vE '^[+-]{2}' | \
    grep -vE '(\?v=|data-asset-version=")' || true)
  if [[ -z "$non_version_diff" ]]; then
    echo "pre-commit: refusing a commit that only bumps the ?v= string."
    echo "            (nothing else changed in $index_file — nothing to redeploy for.)"
    exit 1
  fi
fi
